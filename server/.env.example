# ===== 支付宝充值后端配置 =====
# 复制本文件为 .env 并填入你自己的真实凭证（.env 不要提交到 git）

# 支付宝开放平台：应用 APPID（16位数字）
ALIPAY_APP_ID=

# 支付宝网关。正式环境用下面这个；沙箱用 https://openapi.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 应用私钥（PKCS8，PEM 格式，含 -----BEGIN/END-----）
# 推荐放文件：ALIPAY_PRIVATE_KEY_PATH=./keys/private.pem
# 也可直接写内联（把换行的 \n 写成字面 \\n）：ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nxxx\\n-----END PRIVATE KEY-----"
ALIPAY_PRIVATE_KEY_PATH=./keys/private.pem
ALIPAY_PRIVATE_KEY=

# 支付宝公钥（注意：是「支付宝公钥」不是「应用公钥」），PEM 格式
ALIPAY_PUBLIC_KEY_PATH=./keys/alipay_public.pem
ALIPAY_PUBLIC_KEY=

# 充值套餐：付多少钱得多少蛇币
TOPUP_PRICE=6.00          # 金额（元，两位小数）
TOPUP_COINS=1000          # 对应的蛇币数量

# 后端对外可访问的基址（用于拼接 return/notify 的完整 URL）
# 部署后改成你的真实公网地址，例如 https://pay.yourdomain.com
PUBLIC_BASE=http://localhost:3000

# 前端来源（CORS 放行）。改成你的 GitHub Pages 地址，例如 https://tiantian-b.github.io
FRONTEND_ORIGIN=http://localhost:5500

# 支付后回跳的前端完整地址（含 /snake-game/）。支付宝付款后 302 跳回这里并带 ?paid=&uid= 参数。
# 例：https://tiantian-b.github.io/snake-game/
FRONTEND_RETURN_URL=http://localhost:5500/snake-game/

# 服务端口
PORT=3000
